# Copy this file to .env and fill in your values

# Database
DATABASE_URL="postgresql://postgres:Nadiya666@localhost:5432/hostel_db?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret-min-64-chars"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# CORS
CLIENT_URL="http://localhost:3000"

# Uploads (photos)
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=5

# Timezone (for attendance)
TZ="Asia/Kolkata"
